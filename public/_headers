# connect-src 'self' is for /seymour/, which fetches its bass loop to decode
# and loop it in Web Audio; nothing else on the site fetches.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'none'; style-src 'self'; script-src 'self'; font-src 'self'; img-src 'self' data:; media-src 'self' https://media.agentsee.work; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# The feed is read by every podcast app on its own schedule; ten minutes is
# the longest a wrong episode should survive after a fix is pushed.
/podcast/feed.xml
  Cache-Control: public, max-age=600, must-revalidate

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Media lives outside /assets/ deliberately. Pages applies *every* matching
# rule, in file order, and comma-joins a header that appears twice — so a
# /assets/audio/* rule alongside the /assets/* rule below would have produced
# `Cache-Control: public, max-age=31536000, immutable, public, max-age=600,
# must-revalidate`: two contradictory max-ages, and a must-revalidate that
# defeats the point of the year. Non-overlapping paths need no detach operator.
/media/*
  Cache-Control: public, max-age=31536000, immutable

# Short, because the site is under active development and a stale stylesheet
# is worse than a revalidation request. Ten minutes still bites: a page that
# needs rules nobody has cached yet ships them in a file of its own (see
# assets/diagrams.css), because the edge may hold styles.css from seconds
# before the deploy. The fonts and media above never change, so they get a
# year. Requires the zone's Browser Cache TTL to be "Respect
# Existing Headers" — otherwise Cloudflare overrides all of this. See
# docs/RUNBOOK.md.
/assets/*
  Cache-Control: public, max-age=600, must-revalidate
