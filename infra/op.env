# Resolved by `op run` at the moment tofu starts. Committed on purpose: every
# op:// below is a REFERENCE, not a value, and resolving one requires an
# unlocked 1Password account this file knows nothing about.
#
#   op run --env-file=op.env -- tofu plan
#
# Vault and item names here are a contract. Renaming either breaks the apply,
# so grep this file first. See ../docs/CREDENTIALS.md.
#
# Everything below lives in ONE vault on purpose. When a service account is
# eventually created for CI, it gets read access to Engineering and nothing
# else — least privilege by construction rather than by an audit later.

# ─── Cloudflare ──────────────────────────────────────────────────────────────
# Zone > DNS > Edit on agentsee.work. NOT the Pages-only CI token, which lives
# in GitHub Actions secrets and cannot write DNS.
CLOUDFLARE_API_TOKEN=op://Engineering/Cloudflare API token/credential

# ─── R2, for the state backend only ──────────────────────────────────────────
# The backend speaks S3, so it reads the standard AWS variables. This is the
# tfstate token — the BACKUP bucket has a different token that lives on the
# box, never here. One credential that could both delete the backups and
# rewrite the infrastructure is a bad blast radius.
AWS_ACCESS_KEY_ID=op://Engineering/R2 tfstate token/username
AWS_SECRET_ACCESS_KEY=op://Engineering/R2 tfstate token/credential

# ─── Infomaniak Public Cloud (OpenStack) ─────────────────────────────────────
# The provider reads these directly, so there is no clouds.yaml on disk holding
# a password. Not secret, so inline:
OS_AUTH_URL=https://api.pub1.infomaniak.cloud/identity
OS_REGION_NAME=dc3-a
OS_INTERFACE=public
OS_IDENTITY_API_VERSION=3

# ⚠ TAKE THESE FROM THE OpenRC FILE Infomaniak generates, don't assume.
# Username is PCU-XXXXXXX and project is PCP-XXXXXXX, but the two domain values
# below are a guess at the common default — if auth fails with a domain error,
# that is what this comment is about.
OS_USERNAME=op://Engineering/Infomaniak Public Cloud/username
OS_PASSWORD=op://Engineering/Infomaniak Public Cloud/password
OS_PROJECT_NAME=op://Engineering/Infomaniak Public Cloud/project
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default
