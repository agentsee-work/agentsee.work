# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# NOTHING SECRET GOES IN HERE, and nothing secret goes in your shell either.
# Every credential is resolved from 1Password at the moment tofu runs:
#
#   op run --env-file=op.env -- tofu plan
#
# See op.env for what gets injected, and docs/CREDENTIALS.md for the vault.
# The relay's SMTP credentials are in neither: they are created in the SMTP2GO
# dashboard and typed into the server's .env once.

# A public key is public. Safe here.
ssh_public_key = "ssh-ed25519 AAAA... you@host"

# Narrow this if you have a static IP. Key-only auth is enforced regardless.
# ssh_allowed_ips = ["203.0.113.4/32"]

# ─── Left at defaults until the build says otherwise ────────────────────────

# ⚠ Verify before the first plan — image names move:
#     openstack image list | grep -i debian
# image_name = "Debian 12 bookworm"

# Oversized for mail on purpose: this box is also where things get tried.
# flavor = "a2-ram4-disk20-perf1"

# Extra inbound ports for experiments. Separate security group from mail, so
# widening the box for something you're testing is never the same change as
# widening the mail server. Give every entry a real reason.
# lab_ports = {
#   "8080" = "temporary — poking at the agent webhook, remove by December"
# }

# The three CNAMEs from SMTP2GO's Sender Domains screen. Labels are relative to
# the domain; both halves are generated per account, so these are examples of
# the SHAPE, not values to copy. Empty until the domain is verified there.
#
# Without them, mail still sends — signed as smtp2go.com rather than as us.
# That is invisible at p=none and fatal at p=reject.
#
# smtp2go_cname_records = {
#   "em1234"        = "return.smtp2go.net"
#   "s1._domainkey" = "dkim.smtp2go.net"
#   "link"          = "track.smtp2go.net"
# }

# Empty on the first apply — Stalwart generates the key, so it cannot exist
# before the server does. Fill in from the WebAdmin, then re-apply.
# dkim_public_key = "v=DKIM1; k=rsa; p=MIIBIjANBg..."

# Stays `none` through the migration. Under `reject`, our own unaligned mail is
# discarded silently by recipients — the worst failure mode there is.
# dmarc_policy = "none"

# ⚠ THE CUTOVER. false until inbound, DKIM alignment and a real restore test
# have all passed on the test subdomain. See infra/README.md.
# enable_apex_mx = false
