# This repo is public. Everything here is about that.

# State records every managed value in clear, and gains secrets the moment any
# resource has one. It belongs in R2, never here.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
crash.log
crash.*.log

# Real values — may name IPs, emails, keys.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Plan files contain full resource values, including sensitive ones.
*.tfplan
*.tfplan.*

# Never.
*.pem
*.key
*_rsa
*_ed25519

# The lock file IS committed — it pins provider checksums, and that is the
# point of it. Not ignored, listed here so nobody "tidies" it away.
!.terraform.lock.hcl
