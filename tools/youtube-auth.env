# Resolved by `op run` for the one-time YouTube authorisation. Committed on
# purpose: every op:// below is a REFERENCE, not a value.
#
#   op run --env-file=tools/youtube-auth.env -- ./tools/youtube.py auth
#
# Only the OAuth client: the step that mints the refresh token cannot also
# depend on it (op run refuses to start when a reference does not resolve).
# The client is `podcast-engine` in the Google Cloud project, type Desktop
# app, filed as an API Credential so the fields are username + credential.
# Everything that uses the token afterwards resolves tools/youtube.env.
YOUTUBE_CLIENT_ID=op://Engineering/YouTube podcast client/username
YOUTUBE_CLIENT_SECRET=op://Engineering/YouTube podcast client/credential
