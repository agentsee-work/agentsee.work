# Resolved by `op run` for the one-time Linear consent, which mints the
# engine's refresh token. Committed on purpose: every op:// below is a
# REFERENCE, not a value.
#
#   op run --env-file=tools/linear.env -- ./tools/linear.py auth
#
# Only the app: the step that mints the token cannot also depend on it (op
# run refuses to start when a reference does not resolve). The item holds
# the client id and client secret of the OAuth application "AgentSee Engine"
# (AGE-115, step 3). The engine resolves the token itself, through
# engine/engine.env, and writes each rotated one back to the vault.
LINEAR_CLIENT_ID=op://Engineering/Linear podcast app/username
LINEAR_CLIENT_SECRET=op://Engineering/Linear podcast app/credential
