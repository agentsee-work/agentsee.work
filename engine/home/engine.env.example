# /etc/agentsee/engine.env — root-owned, mode 0600, NOT in git.
# The one secret the engine container starts with. Everything else it needs
# is resolved from the vault by `op run` using this token (engine/engine.env
# lists the references).
#
# A 1Password service account with read access to the Engineering vault and
# write access to it as well, because the X adapter writes one item back
# (engine/publish/x.py). Filed as "Engine service account" in Security.
OP_SERVICE_ACCOUNT_TOKEN=ops_...
