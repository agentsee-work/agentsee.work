# Resolved by `op run` whenever the engine runs: the publisher, the link
# push, the server with its worker. Committed on purpose: every op:// below
# is a REFERENCE, not a value.
#
#   op run --env-file=engine/engine.env -- ./engine/engine.py <command>
#
# op run refuses to start when a reference does not resolve, so only items
# that exist are named here; each platform adapter joins this file with its
# credentials when it is written. Browsing the screens needs none of them:
# `./engine/engine.py serve` runs bare and the worker simply skips what it
# cannot publish, saying so.
YOUTUBE_CLIENT_ID=op://Engineering/YouTube podcast client/username
YOUTUBE_CLIENT_SECRET=op://Engineering/YouTube podcast client/credential
YOUTUBE_REFRESH_TOKEN=op://Engineering/YouTube podcast token/credential
CLOUDFLARE_API_TOKEN=op://Engineering/Cloudflare podcast token/credential
